#!/usr/bin/env bash
# install: build tinydvd, create a dedicated Python virtualenv, and install the
# self-contained runtime into PREFIX (default: /usr/local), with desktop
# integration: GNOME/freedesktop on Linux, TinyDVD.app on macOS.
#
# Everything goes under /usr/local by default so macOS/Linux tools run from a
# single system location and GNOME's thumbnailer sandbox can access it.
#
#   ./install                      Build and install to /usr/local
#   ./install --prefix <dir>       Build and install to a custom prefix
#   ./install --python <path>      Use a specific compatible Python (>= 3.8)
#   ./install --no-deps            Do not auto-run scripts/install-deps.sh
#   ./install --with-libdvdcss     Also install encrypted-DVD ripping support
#                                  (dvdbackup + libdvdcss) without asking
#   ./install --without-libdvdcss  Don't offer it (by default you're asked once
#                                  if it isn't installed yet)
#   ./install --app-dir <dir>      macOS: put TinyDVD.app here (default: /Applications,
#                                  or ~/Applications if the prefix is in your home folder)
#   ./install --uninstall          Remove everything this script installed

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PREFIX="/usr/local"
CUSTOM_PYTHON="${TINYDVD_PYTHON:-}"
INSTALL_DEPS=1
DVDCSS_FLAG=""
UNINSTALL=0
MAC_APP_DIR="${TINYDVD_MAC_APP_DIR:-}"
APP_DIR_GIVEN="${TINYDVD_MAC_APP_DIR:-}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --uninstall)
            UNINSTALL=1
            shift
            ;;
        --no-deps)
            INSTALL_DEPS=0
            shift
            ;;
        --with-libdvdcss|--without-libdvdcss)
            DVDCSS_FLAG="$1"
            shift
            ;;
        --prefix)
            if [[ $# -lt 2 ]]; then
                echo "Error: --prefix requires a directory argument" >&2
                exit 1
            fi
            PREFIX="$2"
            shift 2
            ;;
        --prefix=*)
            PREFIX="${1#*=}"
            shift
            ;;
        --python)
            if [[ $# -lt 2 ]]; then
                echo "Error: --python requires an interpreter path" >&2
                exit 1
            fi
            CUSTOM_PYTHON="$2"
            shift 2
            ;;
        --python=*)
            CUSTOM_PYTHON="${1#*=}"
            shift
            ;;
        --app-dir)
            if [[ $# -lt 2 ]]; then
                echo "Error: --app-dir requires a directory argument" >&2
                exit 1
            fi
            MAC_APP_DIR="$2"
            APP_DIR_GIVEN=1
            shift 2
            ;;
        --app-dir=*)
            MAC_APP_DIR="${1#*=}"
            APP_DIR_GIVEN=1
            shift
            ;;
        -h|--help)
            sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "Unknown option: $1 (try --help)" >&2
            exit 1
            ;;
    esac
done

PREFIX="${PREFIX%/}"
[[ -n "$PREFIX" ]] || PREFIX="/"

BIN_DIR="${PREFIX}/bin"
LIB_DIR="${PREFIX}/lib/tinydvd"
SHARE_DIR="${PREFIX}/share"
APP_DIR="${SHARE_DIR}/applications"
MIME_DIR="${SHARE_DIR}/mime/packages"
THUMB_DIR="${SHARE_DIR}/thumbnailers"
ICON_DIR="${SHARE_DIR}/icons/hicolor"
MIME_TYPES=(video/x-tinydvd application/x-tdvd application/x-tinydvd)
OS="$(uname -s)"

# macOS: where TinyDVD.app goes
if [[ -z "$MAC_APP_DIR" ]]; then
    if [[ -n "${HOME:-}" && "$PREFIX/" == "$HOME/"* ]]; then
        MAC_APP_DIR="${HOME}/Applications"
    else
        MAC_APP_DIR="/Applications"
    fi
fi
MAC_APP_DIR="${MAC_APP_DIR%/}"
MAC_APP="${MAC_APP_DIR}/TinyDVD.app"
# Where the last install put TinyDVD.app, so --uninstall finds it without
# being given the same --app-dir again
MAC_APP_RECORD="${LIB_DIR}/installed-app-path"
if [[ "$UNINSTALL" -eq 1 && -z "$APP_DIR_GIVEN" && -f "$MAC_APP_RECORD" ]]; then
    MAC_APP="$(head -n 1 "$MAC_APP_RECORD")"
    MAC_APP_DIR="$(dirname "$MAC_APP")"
fi

# The per-user cache of web-player videos (rebuilt on demand, so --uninstall
# deletes it). Worked out before any sudo, which may change HOME
if [[ -n "${TINYDVD_USER_CACHE:-}" ]]; then
    USER_CACHE="$TINYDVD_USER_CACHE"
else
    USER_HOME="${HOME:-}"
    if [[ "$(id -u)" -eq 0 && -n "${SUDO_USER:-}" ]]; then
        USER_HOME="$(eval echo "~${SUDO_USER}")"
    fi
    if [[ "$OS" == "Darwin" ]]; then
        USER_CACHE="${USER_HOME}/Library/Caches/tinydvd"
        USER_CONFIG="${USER_HOME}/Library/Application Support/tinydvd"
    else
        USER_CACHE="${XDG_CACHE_HOME:-${USER_HOME}/.cache}/tinydvd"
        USER_CONFIG="${XDG_CONFIG_HOME:-${USER_HOME}/.config}/tinydvd"
    fi
fi
USER_CONFIG="${TINYDVD_USER_CONFIG:-${USER_CONFIG:-}}"
MAC_BUNDLE_ID="io.github.boutell.tinydvd"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

validate_python() {
    local py="$1"
    [[ -n "$py" && -x "$py" ]] || return 1
    if [[ "$OS" == "Darwin" && "$py" == "/usr/bin/python3" ]]; then
        xcode-select -p >/dev/null 2>&1 || return 1
    fi
    local host_arch
    host_arch="$(uname -m)"
    "$py" - "$host_arch" >/dev/null 2>&1 <<'PYEOF'
import ctypes, http.server, platform, select, sys, urllib.request, zipfile, zlib

host_arch = sys.argv[1]
if sys.version_info < (3, 8):
    raise SystemExit(1)
py_arch = platform.machine()
if host_arch and py_arch and py_arch != host_arch:
    raise SystemExit(1)
PYEOF
}

find_compatible_python() {
    if [[ -n "$CUSTOM_PYTHON" ]]; then
        if validate_python "$CUSTOM_PYTHON"; then
            printf '%s\n' "$CUSTOM_PYTHON"
            return 0
        fi
        echo "Error: specified Python '${CUSTOM_PYTHON}' is missing, < 3.8, missing stdlib modules, or wrong architecture for $(uname -m)." >&2
        return 1
    fi

    local candidates=()
    if [[ "$OS" == "Darwin" ]]; then
        if command -v brew >/dev/null 2>&1; then
            local p312
            p312="$(brew --prefix python@3.12 2>/dev/null || true)"
            if [[ -n "$p312" ]]; then
                candidates+=("${p312}/bin/python3.12")
            fi
        fi
        candidates+=(
            "/opt/homebrew/opt/python@3.12/bin/python3.12"
            "/usr/local/opt/python@3.12/bin/python3.12"
            "/opt/homebrew/bin/python3.12"
            "/usr/local/bin/python3.12"
            "/opt/homebrew/bin/python3.13"
            "/usr/local/bin/python3.13"
            "/opt/homebrew/bin/python3"
            "/usr/local/bin/python3"
        )
        local cmd_py
        cmd_py="$(command -v python3 2>/dev/null || true)"
        if [[ -n "$cmd_py" && "$cmd_py" != "/usr/bin/python3" ]]; then
            candidates+=("$cmd_py")
        fi
        candidates+=("/usr/bin/python3")
    else
        candidates+=(
            "/usr/bin/python3"
            "/usr/local/bin/python3"
        )
        local cmd_py
        cmd_py="$(command -v python3 2>/dev/null || true)"
        if [[ -n "$cmd_py" ]]; then
            candidates+=("$cmd_py")
        fi
    fi

    local cand
    for cand in "${candidates[@]}"; do
        if validate_python "$cand"; then
            printf '%s\n' "$cand"
            return 0
        fi
    done

    echo "Error: No compatible Python >= 3.8 interpreter found for $(uname -m)." >&2
    if [[ "$OS" == "Darwin" ]]; then
        echo "Run ./scripts/install-deps.sh or 'brew install python@3.12' first." >&2
    else
        echo "Install python3 (>= 3.8) and python3-venv via your distribution package manager." >&2
    fi
    return 1
}

MISSING_DEPS=()
collect_missing_build_deps() {
    MISSING_DEPS=()
    if ! command -v cmake >/dev/null 2>&1; then
        MISSING_DEPS+=("cmake")
    fi
    if ! command -v pkg-config >/dev/null 2>&1; then
        MISSING_DEPS+=("pkg-config")
        return 0
    fi

    local old_pkg_path="${PKG_CONFIG_PATH:-}"
    if [[ "$OS" == "Darwin" ]]; then
        export PKG_CONFIG_PATH="/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig${old_pkg_path:+:${old_pkg_path}}"
    fi

    local mod
    for mod in mpv sdl2 cairo pangocairo; do
        if ! pkg-config --exists "$mod" >/dev/null 2>&1; then
            MISSING_DEPS+=("$mod")
        fi
    done

    if [[ "$OS" == "Darwin" ]]; then
        if [[ -n "$old_pkg_path" ]]; then
            export PKG_CONFIG_PATH="$old_pkg_path"
        else
            unset PKG_CONFIG_PATH || true
        fi
    fi
}

nearest_existing_dir() {
    local p="$1"
    while [[ ! -e "$p" && "$p" != "/" ]]; do
        p="$(dirname "$p")"
    done
    printf '%s\n' "$p"
}

# True if path is one of the commands this script installs into BIN_DIR: the
# player (which has LIB_DIR built in), a wrapper script that runs LIB_DIR, or
# one of the two compatibility symlinks
is_our_command() {
    local f="$1"
    if [[ -L "$f" ]]; then
        case "$(readlink "$f")" in
            tinydvd|tinydvd-set-thumbnail) return 0 ;;
        esac
        return 1
    fi
    [[ -f "$f" ]] && grep -qaF "${LIB_DIR}" "$f"
}

# True if path is a TinyDVD.app this script made for this PREFIX (its
# launcher has LIB_DIR built in), so uninstalling one prefix leaves another's app
is_this_prefix_mac_app() {
    is_our_mac_app "$1" && grep -qaF "${LIB_DIR}" "$1/Contents/MacOS/TinyDVD" 2>/dev/null
}

# True if path is a TinyDVD.app this script made (so it's safe to replace or remove)
is_our_mac_app() {
    local plist="$1/Contents/Info.plist"
    [[ -f "$plist" ]] && /usr/bin/defaults read "$plist" CFBundleIdentifier 2>/dev/null | grep -qx "$MAC_BUNDLE_ID"
}

needs_sudo() {
    [[ "$(id -u)" -ne 0 ]] || return 1
    if [[ "$UNINSTALL" -eq 1 && ! -e "$LIB_DIR" && ! -e "${BIN_DIR}/tinydvd" ]] \
        && ! is_this_prefix_mac_app "$MAC_APP"; then
        return 1  # nothing here to remove; the uninstall step says so
    fi
    local probe
    probe="$(nearest_existing_dir "$PREFIX")"
    [[ -w "$probe" ]] || return 0
    if [[ -d "$BIN_DIR" && ! -w "$BIN_DIR" ]]; then return 0; fi
    if [[ -d "$LIB_DIR" && ! -w "$LIB_DIR" ]]; then return 0; fi
    if [[ "$MAC_APP_BUILT" -eq 1 || ( "$UNINSTALL" -eq 1 && -e "$MAC_APP" ) ]]; then
        if [[ -e "$MAC_APP" && ! -w "$MAC_APP" ]]; then return 0; fi
        probe="$(nearest_existing_dir "$MAC_APP_DIR")"
        [[ -w "$probe" ]] || return 0
    fi
    return 1
}

# Preserve original CLI args for optional sudo re-exec
ORIG_ARGS=("$@")

BASE_PYTHON="${TINYDVD_BASE_PYTHON:-}"
if [[ "$UNINSTALL" -eq 0 ]]; then
    if [[ "${TINYDVD_ALREADY_BUILT:-0}" != "1" ]]; then
        if [[ -n "$CUSTOM_PYTHON" && -z "$BASE_PYTHON" ]]; then
            BASE_PYTHON="$(find_compatible_python)"
        fi
        DISC_SUPPORT_OFFERED=0
        collect_missing_build_deps
        if [[ -z "$BASE_PYTHON" ]]; then
            BASE_PYTHON="$(find_compatible_python 2>/dev/null || true)"
        fi

        if [[ ${#MISSING_DEPS[@]} -gt 0 || -z "$BASE_PYTHON" ]]; then
            missing_desc="${MISSING_DEPS[*]:-}"
            if [[ -z "$BASE_PYTHON" ]]; then
                missing_desc="${missing_desc:+${missing_desc} }python3(>=3.8)"
            fi
            if [[ "$INSTALL_DEPS" -eq 0 ]]; then
                echo "Error: missing build dependencies: ${missing_desc}" >&2
                echo "Run ./scripts/install-deps.sh first (or re-run without --no-deps)." >&2
                exit 1
            fi
            echo "=== Installing missing dependencies (${missing_desc}) ==="
            # This also offers the optional encrypted-DVD support
            "${ROOT_DIR}/scripts/install-deps.sh" ${DVDCSS_FLAG:+"$DVDCSS_FLAG"}
            DISC_SUPPORT_OFFERED=1

            collect_missing_build_deps
            if [[ ${#MISSING_DEPS[@]} -gt 0 ]]; then
                echo "Error: still missing build dependencies after running install-deps.sh: ${MISSING_DEPS[*]}" >&2
                exit 1
            fi
        fi

        # Optional encrypted-DVD ripping support: offered once if it's missing
        if [[ "$DISC_SUPPORT_OFFERED" -eq 0 && "$INSTALL_DEPS" -eq 1 ]]; then
            "${ROOT_DIR}/scripts/install-deps.sh" --only-libdvdcss ${DVDCSS_FLAG:+"$DVDCSS_FLAG"} \
                || echo "Note: encrypted-DVD support wasn't installed; continuing with everything else."
        fi

        if [[ -z "$BASE_PYTHON" ]]; then
            BASE_PYTHON="$(find_compatible_python)"
        fi

        echo "=== Building tinydvd (Python: ${BASE_PYTHON}) ==="
        cmake -B "${ROOT_DIR}/build" -S "${ROOT_DIR}" \
            -DCMAKE_BUILD_TYPE=Release \
            -DPython3_EXECUTABLE="${BASE_PYTHON}" \
            -DTINYDVD_INSTALL_LIBDIR="${LIB_DIR}"
        cmake --build "${ROOT_DIR}/build" --target tinydvd
        if [[ "$OS" == "Darwin" ]]; then
            # Don't let a launcher left over from another Python stand in
            rm -f "${ROOT_DIR}/build/tinydvd-macos-app"
            if grep -q '^TINYDVD_MACOS_APP:INTERNAL=ON$' "${ROOT_DIR}/build/CMakeCache.txt"; then
                cmake --build "${ROOT_DIR}/build" --target tinydvd_macos_app
            fi
        fi
    elif [[ -z "$BASE_PYTHON" ]]; then
        BASE_PYTHON="$(find_compatible_python)"
    fi
fi

# TinyDVD.app needs a Python that can be embedded; without one, only the app is skipped
MAC_APP_LAUNCHER="${ROOT_DIR}/build/tinydvd-macos-app"
MAC_APP_BUILT=0
if [[ "$OS" == "Darwin" && -x "$MAC_APP_LAUNCHER" ]]; then MAC_APP_BUILT=1; fi

# Say what sudo is for before it asks for a password
explain_sudo() {
    echo ""
    if [[ "$UNINSTALL" -eq 0 ]]; then
        echo "=== Administrator rights needed ==="
        echo "TinyDVD is built (as you). Copying it into ${PREFIX} needs administrator"
        echo "rights, so sudo will ask for your password. As root, this script only writes:"
        echo "  ${BIN_DIR}: tinydvd, convert-to-tinydvd, tinydvd-set-thumbnail, tinydvd-thumbnailer"
        echo "  ${LIB_DIR}: the player library, its Python scripts and a private Python environment"
        if [[ "$OS" == "Linux" ]]; then
            echo "  ${SHARE_DIR}: the app launcher, the .tdvd file type (with tinydvd as its"
            echo "    default app), icons and the file-manager thumbnailer"
        elif [[ "$MAC_APP_BUILT" -eq 1 ]]; then
            echo "  ${MAC_APP}: the app, which also tells macOS it opens .tdvd files"
        fi
        echo "Nothing else is changed. './install --uninstall' removes it all."
        echo ""
        echo "To install without sudo, press Ctrl-C now and run: ./install --prefix ~/.local"
        if [[ "$OS" == "Linux" ]]; then
            echo "(GNOME Files won't show .tdvd thumbnails then: its thumbnailer sandbox can't"
            echo "see your home folder.)"
        fi
    else
        echo "=== Administrator rights needed ==="
        echo "TinyDVD is installed in ${PREFIX}, so removing it needs administrator rights."
        echo "sudo will ask for your password, then this script deletes only what"
        if [[ "$OS" == "Linux" ]]; then
            echo "'./install' put in ${BIN_DIR}, ${LIB_DIR} and"
            echo "${SHARE_DIR} (launcher, file type, icons, thumbnailer)."
        else
            if is_this_prefix_mac_app "$MAC_APP"; then
                echo "'./install' put in ${BIN_DIR} and ${LIB_DIR}, and ${MAC_APP}."
            else
                echo "'./install' put in ${BIN_DIR} and ${LIB_DIR}."
            fi
        fi
    fi
    echo ""
}

# Escalate with sudo only if target prefix is not writable by current user
if needs_sudo; then
    explain_sudo
    if [[ "$UNINSTALL" -eq 0 ]]; then
        exec sudo TINYDVD_BASE_PYTHON="${BASE_PYTHON}" TINYDVD_ALREADY_BUILT=1 "${BASH_SOURCE[0]}" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
    else
        exec sudo TINYDVD_USER_CACHE="${USER_CACHE}" TINYDVD_USER_CONFIG="${USER_CONFIG}" \
            "${BASH_SOURCE[0]}" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
    fi
fi

refresh_caches() {
    if command -v update-mime-database >/dev/null 2>&1; then
        update-mime-database "${SHARE_DIR}/mime" || true
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "${APP_DIR}" || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -q -t "${ICON_DIR}" || true
    fi
}

# Make tinydvd the default application for .tdvd files ("add"), or undo that
# ("remove"), in <prefix>/share/applications/mimeapps.list.
set_default_handler() {
    local py_bin="$1"
    local action="$2"
    "$py_bin" - "${APP_DIR}/mimeapps.list" "$action" "${MIME_TYPES[@]}" <<'PYEOF'
import configparser, os, sys

path, action, mimes = sys.argv[1], sys.argv[2], sys.argv[3:]
cp = configparser.ConfigParser(interpolation=None)
cp.optionxform = str
if os.path.exists(path):
    cp.read(path)
section = "Default Applications"
if action == "add":
    if not cp.has_section(section):
        cp.add_section(section)
    for m in mimes:
        cp.set(section, m, "tinydvd.desktop")
elif cp.has_section(section):
    for m in mimes:
        if cp.get(section, m, fallback="") == "tinydvd.desktop":
            cp.remove_option(section, m)
    if not cp.options(section):
        cp.remove_section(section)
if cp.sections():
    with open(path, "w") as f:
        cp.write(f, space_around_delimiters=False)
elif os.path.exists(path):
    os.remove(path)
PYEOF
}

# Build TinyDVD.app: a launcher that runs the runtime in LIB_DIR, the icon,
# and an Info.plist that registers TinyDVD as the app for .tdvd files
install_mac_app() {
    local launcher="$MAC_APP_LAUNCHER"
    if [[ -e "$MAC_APP" ]] && ! is_our_mac_app "$MAC_APP"; then
        echo "Error: ${MAC_APP} exists and isn't one this script installed; not replacing it." >&2
        echo "Move it aside, or install elsewhere with --app-dir <dir>." >&2
        exit 1
    fi
    local version
    version="$(sed -n 's/^TINYDVD_VERSION = "\(.*\)"$/\1/p' "${ROOT_DIR}/scripts/tinydvd_app.py")"
    echo "App -> ${MAC_APP}"
    rm -rf "$MAC_APP"
    install -d "${MAC_APP}/Contents/MacOS" "${MAC_APP}/Contents/Resources"
    install -m 755 "$launcher" "${MAC_APP}/Contents/MacOS/TinyDVD"
    install -m 644 "${ROOT_DIR}/data/icons/tinydvd.icns" "${MAC_APP}/Contents/Resources/tinydvd.icns"
    sed -e "s/@VERSION@/${version:-0}/g" "${ROOT_DIR}/data/macos/Info.plist" > "${MAC_APP}/Contents/Info.plist"
    chmod 644 "${MAC_APP}/Contents/Info.plist"
    # Sign it ad hoc (no developer account needed), as Apple Silicon requires
    if ! codesign --force --sign - "$MAC_APP" >/dev/null 2>&1; then
        echo "Note: couldn't sign ${MAC_APP}; macOS may refuse to open it." >&2
    fi
    # Tell Finder about the app and the .tdvd file type now, not at next login
    "$LSREGISTER" -f "$MAC_APP" >/dev/null 2>&1 || true
    printf '%s\n' "$MAC_APP" > "$MAC_APP_RECORD"
}

if [[ "$UNINSTALL" -eq 1 ]]; then
    echo "=== Uninstalling tinydvd from ${PREFIX} ==="
    FOUND=0
    [[ -d "$LIB_DIR" ]] && FOUND=1
    for name in tinydvd tinydvd-player convert-to-tinydvd tinydvd-thumbnailer \
                tinydvd-set-thumbnail tinydvd-add-thumbnail; do
        f="${BIN_DIR}/${name}"
        [[ -e "$f" || -L "$f" ]] || continue
        if is_our_command "$f"; then
            rm -f "$f"
            FOUND=1
        else
            echo "Left ${f} alone: it isn't one './install' put there."
        fi
    done
    if [[ "$OS" == "Linux" ]]; then
        UNINSTALL_PY="${LIB_DIR}/venv/bin/python3"
        if [[ ! -x "$UNINSTALL_PY" ]]; then
            UNINSTALL_PY="$(command -v python3 2>/dev/null || true)"
        fi
        rm -f "${APP_DIR}/tinydvd.desktop" "${MIME_DIR}/tinydvd.xml" \
              "${THUMB_DIR}/tinydvd.thumbnailer" \
              "${ICON_DIR}/scalable/apps/tinydvd.svg" \
              "${ICON_DIR}/scalable/mimetypes/video-x-tinydvd.svg"
        if [[ -f "${APP_DIR}/mimeapps.list" && -n "$UNINSTALL_PY" && -x "$UNINSTALL_PY" ]]; then
            set_default_handler "$UNINSTALL_PY" remove
        fi
        refresh_caches
    fi
    if [[ "$OS" == "Darwin" ]] && is_this_prefix_mac_app "$MAC_APP"; then
        "$LSREGISTER" -u "$MAC_APP" >/dev/null 2>&1 || true
        rm -rf "$MAC_APP"
        echo "Removed ${MAC_APP}"
        FOUND=1
    fi
    rm -rf "${LIB_DIR}"
    if [[ -n "$USER_CACHE" && -d "$USER_CACHE" ]]; then
        rm -rf "$USER_CACHE"
        echo "Removed the web player's video cache (${USER_CACHE})"
    fi
    if [[ "$FOUND" -eq 0 ]]; then
        echo "Nothing from TinyDVD was found in ${PREFIX}."
        echo "If you installed it with --prefix (or --app-dir), uninstall with the same option."
        for other in /usr/local "${HOME:-}/.local"; do
            if [[ "$other" != "$PREFIX" && -d "${other}/lib/tinydvd" ]]; then
                echo "It is installed in ${other}: ./install --uninstall --prefix ${other}"
            fi
        done
        exit 1
    fi
    echo "tinydvd uninstalled from ${PREFIX}."
    if [[ -n "$USER_CONFIG" && -d "$USER_CONFIG" ]]; then
        echo "Your settings (including the web password) are still in ${USER_CONFIG};"
        echo "delete that folder too if you won't be reinstalling."
    fi
    exit 0
fi

TINYDVD_BIN="${ROOT_DIR}/build/tinydvd"
if [[ "$OS" == "Darwin" ]]; then
    CORE_LIB_NAME="libtinydvd_core.dylib"
else
    CORE_LIB_NAME="libtinydvd_core.so"
fi
CORE_LIB_SRC="${ROOT_DIR}/build/${CORE_LIB_NAME}"

if [[ ! -x "$TINYDVD_BIN" || ! -f "$CORE_LIB_SRC" ]]; then
    echo "Error: ${TINYDVD_BIN} or ${CORE_LIB_SRC} not found. Build failed or incomplete." >&2
    exit 1
fi

if [[ -z "$BASE_PYTHON" ]]; then
    BASE_PYTHON="$(find_compatible_python)"
fi

echo "=== Installing tinydvd to ${PREFIX} ==="
install -d "${BIN_DIR}" "${LIB_DIR}" "${LIB_DIR}/scripts"

VENV_DIR="${LIB_DIR}/venv"
echo "Python venv -> ${VENV_DIR} (base: ${BASE_PYTHON})"
if "${BASE_PYTHON}" -m venv --clear --without-pip "${VENV_DIR}" 2>/dev/null; then
    if [[ ! -x "${VENV_DIR}/bin/python3" && -x "${VENV_DIR}/bin/python" ]]; then
        ln -sf python "${VENV_DIR}/bin/python3"
    fi
else
    echo "Note: python -m venv unavailable; pinning direct symlink in ${VENV_DIR}/bin/python3"
    rm -rf "${VENV_DIR}"
    install -d "${VENV_DIR}/bin"
    ln -sf "${BASE_PYTHON}" "${VENV_DIR}/bin/python3"
fi
VENV_PYTHON="${VENV_DIR}/bin/python3"
if [[ ! -x "$VENV_PYTHON" ]]; then
    echo "Error: Failed to provision ${VENV_PYTHON}" >&2
    exit 1
fi

echo "Runtime -> ${LIB_DIR}"
install -m 755 "${CORE_LIB_SRC}" "${LIB_DIR}/${CORE_LIB_NAME}"
install -d "${LIB_DIR}/web"
install -m 644 "${ROOT_DIR}/web/index.html" "${LIB_DIR}/web/index.html"
rm -f "${LIB_DIR}/web_assets.h"

RUNTIME_SCRIPTS=(
    tinydvd_app.py
    tinydvd_archive.py
    tinydvd_core.py
    tinydvd_desktop_ui.py
    tinydvd_library.py
    tinydvd_metadata.py
    tinydvd_web_server.py
    convert-to-tinydvd.py
    tinydvd-thumbnailer.py
    tinydvd-set-thumbnail.py
)
for s in "${RUNTIME_SCRIPTS[@]}"; do
    install -m 755 "${ROOT_DIR}/scripts/${s}" "${LIB_DIR}/scripts/${s}"
done
"${VENV_PYTHON}" -m py_compile "${LIB_DIR}"/scripts/*.py

write_wrapper() {
    local name="$1"
    local script_file="$2"
    local target="${BIN_DIR}/${name}"
    cat > "${target}" <<EOF
#!/bin/sh
exec "${VENV_PYTHON}" "${LIB_DIR}/scripts/${script_file}" "\$@"
EOF
    chmod 755 "${target}"
}

echo "Programs -> ${BIN_DIR}"
install -m 755 "${TINYDVD_BIN}" "${BIN_DIR}/tinydvd"
ln -sf tinydvd "${BIN_DIR}/tinydvd-player"
write_wrapper "convert-to-tinydvd" "convert-to-tinydvd.py"
write_wrapper "tinydvd-thumbnailer" "tinydvd-thumbnailer.py"
write_wrapper "tinydvd-set-thumbnail" "tinydvd-set-thumbnail.py"
ln -sf tinydvd-set-thumbnail "${BIN_DIR}/tinydvd-add-thumbnail"

if [[ "$OS" == "Linux" ]]; then
    install -d "${APP_DIR}" "${MIME_DIR}" "${THUMB_DIR}" \
               "${ICON_DIR}/scalable/apps" "${ICON_DIR}/scalable/mimetypes"

    # Absolute paths in Exec / TryExec, so neither the launcher nor the
    # thumbnailer sandbox depends on PATH
    echo "Launcher -> ${APP_DIR}/tinydvd.desktop"
    {
        grep -v '^TryExec=' "${ROOT_DIR}/data/tinydvd.desktop" |
            sed -e "s|^Exec=.*|TryExec=${BIN_DIR}/tinydvd\\
Exec=${BIN_DIR}/tinydvd -f %f|"
    } > "${APP_DIR}/tinydvd.desktop"
    chmod 644 "${APP_DIR}/tinydvd.desktop"

    echo "File type -> ${MIME_DIR}/tinydvd.xml"
    install -m 644 "${ROOT_DIR}/data/tinydvd.xml" "${MIME_DIR}/tinydvd.xml"

    echo "Thumbnailer -> ${THUMB_DIR}/tinydvd.thumbnailer"
    sed -e "s|^Exec=.*|Exec=${BIN_DIR}/tinydvd-thumbnailer -s %s %i %o|" \
        -e "s|^TryExec=.*|TryExec=${BIN_DIR}/tinydvd-thumbnailer|" \
        "${ROOT_DIR}/data/tinydvd.thumbnailer" > "${THUMB_DIR}/tinydvd.thumbnailer"
    chmod 644 "${THUMB_DIR}/tinydvd.thumbnailer"

    echo "Icons -> ${ICON_DIR}"
    install -m 644 "${ROOT_DIR}/data/icons/tinydvd.svg" "${ICON_DIR}/scalable/apps/tinydvd.svg"
    install -m 644 "${ROOT_DIR}/data/icons/tinydvd.svg" "${ICON_DIR}/scalable/mimetypes/video-x-tinydvd.svg"

    set_default_handler "${VENV_PYTHON}" add
    refresh_caches

    echo ""
    echo "Installed cleanly with isolated Python runtime (${VENV_PYTHON})."
    echo "Double-click any .tdvd file in GNOME Files to play it."
    echo "If Nautilus was already open, restart it (nautilus -q) to pick up thumbnails."
else
    if [[ "$MAC_APP_BUILT" -eq 1 ]]; then install_mac_app; fi
    echo ""
    echo "Installed cleanly to ${PREFIX} with isolated Python runtime (${VENV_PYTHON})."
    if [[ "$MAC_APP_BUILT" -eq 1 ]]; then
        echo "Open TinyDVD from ${MAC_APP_DIR} or Launchpad, or double-click any .tdvd file in Finder."
    else
        echo "TinyDVD.app skipped: ${BASE_PYTHON} can't be embedded in an app."
        echo "Use the tinydvd command, or get the app by reinstalling with Homebrew's Python:"
        echo "  brew install python@3.12 && ./install --python \"\$(brew --prefix python@3.12)/bin/python3.12\""
    fi
    echo "From Terminal: ${BIN_DIR}/tinydvd ~/Movies   or   ${BIN_DIR}/tinydvd --serve ~/Movies"
fi
